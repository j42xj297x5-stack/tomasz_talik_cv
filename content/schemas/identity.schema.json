{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomasz-talik-cv.local/schemas/identity.schema.json",
  "type": "object",
  "required": ["id", "status", "name"],
  "properties": {
    "id": { "$ref": "common.schema.json#/definitions/stableId" },
    "status": { "$ref": "common.schema.json#/definitions/itemStatus" },
    "name": { "type": "string", "minLength": 1 },
    "headline": { "$ref": "common.schema.json#/definitions/localizedText" },
    "avatar": { "$ref": "common.schema.json#/definitions/assetPath" },
    "portrait": {
      "type": "object",
      "required": ["src", "alt"],
      "properties": {
        "src": { "$ref": "common.schema.json#/definitions/assetPath" },
        "alt": { "$ref": "common.schema.json#/definitions/localizedText" },
        "printSrc": { "$ref": "common.schema.json#/definitions/assetPath" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
