{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomasz-talik-cv.local/schemas/links.schema.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "kind", "label", "url"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/stableId" },
          "status": { "$ref": "common.schema.json#/definitions/itemStatus" },
          "kind": { "type": "string", "enum": ["profile", "repository", "demo"] },
          "label": { "$ref": "common.schema.json#/definitions/localizedText" },
          "url": { "type": "string", "format": "uri" },
          "projectId": { "$ref": "common.schema.json#/definitions/stableId" },
          "projectLabel": { "$ref": "common.schema.json#/definitions/localizedText" }
        },
        "dependencies": {
          "projectId": ["projectLabel"],
          "projectLabel": ["projectId"]
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
