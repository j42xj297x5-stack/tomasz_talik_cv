{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomasz-talik-cv.local/schemas/education.schema.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stableId", "status", "institution", "degree", "period", "description"],
        "properties": {
          "stableId": { "$ref": "common.schema.json#/definitions/stableId" },
          "status": { "$ref": "common.schema.json#/definitions/itemStatus" },
          "institution": { "$ref": "common.schema.json#/definitions/localizedText" },
          "degree": { "$ref": "common.schema.json#/definitions/localizedText" },
          "specialization": { "$ref": "common.schema.json#/definitions/localizedText" },
          "period": { "type": "string", "minLength": 1 },
          "description": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/definitions/localizedText" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
