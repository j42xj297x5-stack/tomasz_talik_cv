{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomasz-talik-cv.local/schemas/common.schema.json",
  "title": "Common content definitions",
  "definitions": {
    "localizedText": {
      "type": "object",
      "required": ["pl"],
      "properties": {
        "pl": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^(default|p_[A-Za-z0-9]+)$"
    },
    "assetPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*://).+"
    },
    "itemStatus": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    }
  }
}
