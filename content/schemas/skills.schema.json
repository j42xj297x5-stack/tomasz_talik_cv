{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tomasz-talik-cv.local/schemas/skills.schema.json",
  "type": "object",
  "required": ["categories", "items"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/stableId" },
          "name": { "$ref": "common.schema.json#/definitions/localizedText" }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "name", "categoryId", "inCloud"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/stableId" },
          "status": { "$ref": "common.schema.json#/definitions/itemStatus" },
          "name": { "$ref": "common.schema.json#/definitions/localizedText" },
          "categoryId": { "$ref": "common.schema.json#/definitions/stableId" },
          "inCloud": { "type": "boolean" },
          "cloudWeight": { "type": "integer", "minimum": 1, "maximum": 3 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
