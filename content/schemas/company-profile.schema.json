{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company profile overlay",
  "type": "object",
  "required": ["id", "companyName"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$",
      "minLength": 32,
      "maxLength": 128
    },
    "companyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
